{
    "xsappname": "sales-order-backend",
    "tenant-mode": "dedicated",
    "description": "Security profile of Sales Order Backend App",
    "scopes":[
            {
                "name": "uaa.user",
                "description": "UAA user"
            },
            {
                "name": "$XSAPPNAME.admin",
                "description": "Admin use"
            },
            {
                "name": "$XSAPPNAME.read_only_user",
                "description": "Read only User"
            },
            {
                "name": "$XSAPPNAME.technical_admin",
                "description": "Technical admin access"
            }
    ],
    "attributes":[
            {
                "name": "id",
                "description": "User id",
                "valueType": "string",
                "valueRequired": false
            },
            {
                "name": "groups",
                "description": "User groups",
                "valueType": "string",
                "valueRequired": false
            }
    ],
    "role-templates":[
        {
            "name": "Token_Exchange",
            "description": "UAA",
            "scope-references":[
                "uaa.user"
            ]
        },
         {
            "name": "admin",
            "description": "Admin user",
            "attribute-references":[
                "id",
                "groups"
            ],
            "scope-references":[
                "$XSAPPNAME.admin"
            ]
        },
        {
            "name": "read_only_user",
            "description": "Read only user",
            "attribute-references":[
                "id",
                "groups"
            ],
            "scope-references":[
                "$XSAPPNAME.read_only_user"
            ]
        },
        {
            "name": "technical_admin",
            "description": "Technical admin access",
            "scope-references": [
                "$XSAPPNAME.technical_admin"
            ]
        }
    ],
      "authorities": [
    "$XSAPPNAME.technical_admin"
  ],
    "oauth2-configuration": {
        "redirect-uris": [
            "https://ba813a92trial-*/**"
        ]
    }
}